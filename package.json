{
  "name": "clerd",
  "version": "2.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Full-stack edge-native Discord competitor hosted on Cloudflare Free Plan (Workers, D1, Durable Objects, R2, Workers AI, Auth0, WebRTC SFU)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "db:migrate:local": "wrangler d1 migrations apply clerd-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply clerd-production --remote",
    "migrate:discord": "tsx scripts/migrate-discord.ts",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "lucide-react": "^0.454.0",
    "mediasoup-client": "^3.7.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "wrangler": "^3.83.0"
  }
}
